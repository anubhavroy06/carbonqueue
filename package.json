{
  "name": "carbonqueue",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "serve": "node scripts/server.mjs",
    "test:browser": "node tests/browser.mjs",
    "lint": "node scripts/lint.mjs",
    "test:release": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
